{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status", "summary", "candidateVersions", "issues"],
  "additionalProperties": false,
  "properties": {
    "status": { "enum": ["completed", "needs-review", "blocked"] },
    "summary": { "type": "string" },
    "candidateVersions": { "type": "array", "items": { "type": "string" } },
    "issues": { "type": "array", "items": { "type": "string" } }
  }
}
